{
  "name": "@vited/create",
  "version": "0.0.7",
  "description": "Create and initialize Vited documentation projects",
  "keywords": [
    "cli",
    "documentation",
    "vited"
  ],
  "homepage": "https://github.com/vitedjs/create#readme",
  "bugs": {
    "url": "https://github.com/vitedjs/create/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Guo Yunhe",
    "email": "i@guoyunhe.me",
    "url": "https://guoyunhe.me/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitedjs/create.git"
  },
  "funding": "https://ko-fi.com/guoyunhe",
  "bin": {
    "vited-create": "./dist/vited-create.mjs"
  },
  "files": [
    "dist",
    "favicon.svg",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/vited-create.ts",
    "docs:build": "vited build",
    "docs:dev": "vited dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^11.0.0",
    "i18next": "^26.5.11",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@guoyunhe/oxfmt-config": "^1.1.0",
    "@tsconfig/node20": "^20.1.2",
    "@tsconfig/strictest": "^2.0.2",
    "@types/node": "^20.5.8",
    "@vited/cli": "^0.1.2",
    "@vited/core": "^0.2.0",
    "@vited/theme-mantine": "^0.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-config-recommended": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.2",
    "tsx": "^4.23.15",
    "typescript": "^5.2.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,jsx,tsx,vue}": [
      "oxfmt --write",
      "oxlint --fix"
    ],
    "*.css": "oxfmt --write",
    "*.{json,jsonc,scss,less,htm,html,md,mdx,yaml,yml}": "oxfmt --write"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.15.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "^26.12.1 || ^24.22.1 || ^22.23.4"
  }
}
